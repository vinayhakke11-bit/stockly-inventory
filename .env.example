PORT=
DATABASE_URL=
NODE_ENV=development
# Enable verified PostgreSQL TLS in production; Node's trusted CA roots are used by default.
DATABASE_SSL=false
# Optional PEM CA certificate/bundle for database providers with a private CA.
DATABASE_SSL_CA=
SESSION_SECRET=
SESSION_MAX_AGE_MS=28800000
SESSION_COOKIE_SECURE=false
# Maximum login requests per IP during the configured window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
ALLOW_OWNER_BOOTSTRAP=false
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
